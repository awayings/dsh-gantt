# /etc/dsh-gantt/mcp.env — install as 0600, root- or service-user-owned.
# Bind 0.0.0.0 so the LAN/overlay network can reach the MCP endpoint; the
# server refuses a non-loopback bind without GANTT_MCP_TOKEN.
GANTT_MCP_HOST=0.0.0.0
GANTT_MCP_PORT=8765
# openssl rand -hex 32
GANTT_MCP_TOKEN=replace-with-a-32-byte-hex-token
DSH_GANTT_DB=/data/dsh-home/gantt/tasks.db
