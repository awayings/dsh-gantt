{
  "name": "@local/dsh-gantt",
  "version": "1.5.0",
  "private": true,
  "description": "A hierarchical task Gantt page with weekly and monthly timelines, backed by SQLite.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./store": "./src/host/store.js",
    "./icon": "./icon.svg"
  },
  "bin": {
    "gantt-mcp": "./bin/gantt-mcp.js"
  },
  "files": [
    "src",
    "bin",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --project host --project client",
    "coverage": "vitest run --project host --project client --coverage",
    "e2e": "node scripts/build-client.mjs && vitest run --project e2e",
    "mcp": "node bin/gantt-mcp.js",
    "static": "pnpm run lint && pnpm run typecheck",
    "check": "node scripts/run-bash.mjs scripts/check.sh",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare": "husky && node scripts/build-client.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "oxlint": "1.85.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rolldown": "1.2.19",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "gantt",
    "tasks",
    "sqlite",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awayings/dsh-gantt.git"
  },
  "homepage": "https://github.com/awayings/dsh-gantt",
  "bugs": {
    "url": "https://github.com/awayings/dsh-gantt/issues"
  }
}
