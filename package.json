{
  "name": "@local/dsh-gantt",
  "version": "1.0.0",
  "private": true,
  "description": "A hierarchical task Gantt page with weekly and monthly timelines, backed by SQLite.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./store": "./store.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "store.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
